<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Legacy reference only. Current unattended setup does not install this launch agent. Source-checkout
removal is owned by Scripts/uninstall.sh, which binds the exact current-user launchd service,
performs bounded absence readback, and removes only the fixed LogicProMCP plist path.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.logicpro.mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/LogicProMCP</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/logic-pro-mcp.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/logic-pro-mcp.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LOG_LEVEL</key>
        <string>INFO</string>
    </dict>
</dict>
</plist>
